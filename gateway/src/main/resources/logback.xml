<configuration>
    <!--
      Structured, grep-friendly key=value logging. The MDC carries the request id
      (set by GatewayHandler), so every log line for a request can be correlated.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level thread=%thread logger=%logger{0} requestId=%X{requestId:--} %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Async so logging never blocks request threads on stdout I/O. -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.javalin" level="WARN"/>
    <logger name="com.gatepulse" level="${LOG_LEVEL:-INFO}"/>

    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>

    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook"/>
</configuration>
